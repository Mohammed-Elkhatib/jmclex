---
import { SEO } from '@wix/seo/components';
import { loadSEOTagsServiceConfig } from '@wix/seo/services';
import { Head } from "@/components/Head";
import AppRouter from "@/components/Router";
import "@/lib/init-language";
import "@wix/wix-vibe-plugins/plugins-vars.css";
import "@wix/wix-vibe-plugins/plugins-theme.css";
import "@/styles/global.css";

const seoTagsServiceConfig = await loadSEOTagsServiceConfig({
  pageUrl: Astro.url.href,
  itemData: {
    pageName: 'Home',
  },
});
---

<html lang="en" class="w-full h-full">
  <head>
    <title>JMC LEX | International Legal, Strategic & Compliance Advisory Platform</title>
    <meta name="description" content="JMC LEX: Premier international legal advisory platform for cross-border compliance, strategic business counsel, and multilingual legal infrastructure across EMEA. Expert guidance for multinational corporations and investors." />
    <meta name="keywords" content="international law firm, cross-border legal advisory, compliance counsel, EMEA legal services, strategic business law, international legal infrastructure, multilingual legal advisory" />
    <Head />
    <SEO.Tags seoTagsServiceConfig={seoTagsServiceConfig} slot="seo-tags" />
    <!-- Additional SEO & Authority Signals -->
    <meta property="og:title" content="JMC LEX | International Legal, Strategic & Compliance Advisory Platform" />
    <meta property="og:description" content="Expert international legal advisory, cross-border compliance, and strategic business counsel for multinational corporations and high-net-worth individuals across EMEA." />
    <meta property="og:type" content="website" />
    <meta name="twitter:title" content="JMC LEX | International Legal Advisory & Compliance" />
    <meta name="twitter:description" content="Premier international law firm specializing in cross-border legal advisory, compliance, and strategic business counsel across EMEA." />
    <!-- Structured Data for Legal Authority -->
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "LegalService",
      "name": "JMC LEX",
      "description": "International legal advisory platform specializing in cross-border compliance, strategic business counsel, and multilingual legal infrastructure",
      "url": "https://jmclex.com",
      "areaServed": ["FR", "LB", "CH", "AE", "SA", "KW", "EU"],
      "serviceType": ["International Law", "Corporate Law", "Compliance Advisory", "Cross-Border Legal Services"],
      "priceRange": "$$"
    }
    </script>
  </head>
  <body class="w-full h-full">
    <div id="root" class="w-full h-full">
      <AppRouter client:only="react" />
    </div>
  </body>
</html>
